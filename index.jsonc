{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/webcache",

  // 1-2 sentence summary about this repo.
  "summary": "Downloaded web content as a cache the nodes of an rljson network share: own store → fleet (peer reads, hub relay) → cloud; claims so simultaneous requesters download once; CDC-block ingest with resume, size/MD5 checks; loopback HTTP endpoint; sliding lifetime, disk budget, sweep. API: Webcache, WebcacheHttpServer, WebcacheRoute, webcacheHubStores, Fleet.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "one download per network: lookup, claim, wait and copy between nodes",
    "large downloads in blocks: streamed while stored, resumed, verified",
    "a local, bounded cache: lifetime, budget, pins, numbers per file"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "bs": "Bs, BsPeer, BsMem, ContentId, forEachBlock, writeBlocks: blocks, ids, peer reads of blobs",
      "io": "Io, IoPeer, IoMem: the index and peer reads of rows",
      "rljson": "Rljson, Route, TableCfg: the index table",
      "hash": "hip: the table config",
      "server": "RouteMember, Client, PeerReadServer, SocketLike, ServerLogger: route member and peer serving"
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "cos-one-client": "Webcache, WebcacheHttpServer (+ /graphic route), WebcacheRoute, webcacheHubStores"
    }
  }
}
